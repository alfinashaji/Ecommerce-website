<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Saved Address</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      body {
        background-color: #f5f5f5;
        font-family: Arial, sans-serif;
      }

      .content-box {
        padding: 0px 100px;
        margin: 60px auto;
      }

      .address-card {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
      }

      .address-name {
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 5px;
      }

      .address-text {
        font-size: 14px;
        color: #555;
      }

      .btn-dark {
        background: #000;
        border: none;
        padding: 8px 18px;
        font-size: 14px;
      }

      .btn-danger {
        background: #d64541;
        border: none;
        padding: 8px 18px;
        font-size: 14px;
      }

      .top-btn {
        padding: 10px 20px;
      }

      .back-link {
        margin-top: 15px;
        display: inline-block;
        text-decoration: none;
        color: #000;
      }
    </style>
  </head>

  <body>
    <!-- NAVBAR -->
  <%- include("../partials/navbar") %>
    <div class="content-box">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-semibold">Saved Address</h4>

        <a href="/profile/address/new" class="btn btn-dark top-btn">
          Add new Address
        </a>
      </div>

      <% if (addresses.length > 0) { %>
        <% addresses.forEach(addr => { %>

          <div class="address-card mb-3">

            <div>
              <div class="address-name"><%= addr.name %></div>
              <div class="address-text">
                <%= addr.street %>, <%= addr.city %>, 
                <%= addr.state %> - <%= addr.pincode %> -------- , Address Type : Home
              </div>
            </div>

            <div class="d-flex gap-2">
              <a href="/profile/address/<%= addr._id %>/edit" class="btn btn-dark">
                Edit
              </a>

              <button onclick="deleteAddress('<%= addr._id %>')" class="btn btn-danger">
                Remove
              </button>
            </div>

          </div>

        <% }) %>
      <% } else { %>
        <p>No address found</p>
      <% } %>

      <a href="/profile" class="back-link">
         <i class="fa fa-arrow-left"></i> Back</a>

    </div>
    <script>
      async function deleteAddress(id){
        if(!confirm("Delete address?")) return;

        const res = await fetch(`/profile/address/${id}`, {
          method: "DELETE"
        });

        const result = await res.json();
        alert(result.message);
        location.reload();
      }
    </script>
  </body>
</html>