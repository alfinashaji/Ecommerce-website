<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<%- include("../partials/navbar") %>


<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Order Details</h2>

            <p class="mb-0">
                Order ID:
                <strong><%= order.orderId %></strong>
            </p>

            <small class="text-muted">
                Ordered on
                <%= new Date(order.createdAt).toLocaleDateString() %>
            </small>
        </div>

       <% if(item.status === "Delivered"){ %>
<div>
    <a
        href="/orders/<%= order._id %>/invoice"
        class="btn btn-outline-dark"
    >
        View Invoice
    </a>
</div>
<% } %>

    </div>

    <div class="card mb-4">
        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
    <h6>Order Status</h6>

    <% if(item.status === "Cancelled"){ %>

        <span class="badge bg-danger">
            Cancelled
        </span>

    <% } else if(item.status === "Returned"){ %>

        <span class="badge bg-dark">
            Returned
        </span>

    <% } else if(item.returnStatus &&
                item.returnStatus.toLowerCase() === "requested"){ %>

        <span class="badge bg-warning text-dark">
            Return Requested
        </span>

    <% } else { %>

        <span class="badge bg-success">
            <%= item.status %>
        </span>

    <% } %>
</div>
<% if(item.status === "Placed" || item.status === "Processing"){ %>

    <div class="mt-3">
       <button
    type="button"
    class="btn btn-outline-danger"
    data-bs-toggle="modal"
    data-bs-target="#cancelModal"
>
    Cancel Product
</button>
    </div>

<% } %>
                <div class="col-md-4">
                    <h6>Payment Method</h6>

                    <p><%= order.paymentMethod %></p>
                </div>

                <div class="col-md-4">
                    <h6>Payment Status</h6>

                    <span class="badge bg-warning text-dark">
                        <%= order.paymentStatus %>
                    </span>
                </div>

            </div>

        </div>
    </div>

    <div class="card mb-4">

        <div class="card-header">
            Delivery Address
        </div>

        <div class="card-body">

            <strong><%= order.address.name %></strong>

            <p class="mb-1">
                <%= order.address.street %>
            </p>

            <p class="mb-1">
                <%= order.address.city %>,
                <%= order.address.state %>
            </p>

            <p class="mb-1">
                <%= order.address.pincode %>
            </p>

            <p>
                <%= order.address.phone %>
            </p>

        </div>

    </div>

    <div class="card">

        <div class="card-header">
            Product Details
        </div>

        <div class="card-body">

            <div class="row border-bottom py-3 align-items-center">

                <div class="col-md-4">

                    <h6>
                        <%= item.productName %>
                    </h6>

                    <small>
                        Size: <%= item.size %>
                    </small>

                    <br>

                    <small>
                        Color: <%= item.color %>
                    </small>

                </div>

                <div class="col-md-2">
                    Qty: <%= item.quantity %>
                </div>

                <div class="col-md-2">
                    ₹<%= item.finalPrice %>
                </div>

                <div class="col-md-4">

                    <% if(item.status === "Placed"){ %>
                        <span class="badge bg-secondary">Placed</span>

                    <% } else if(item.status === "Processing"){ %>
                        <span class="badge bg-warning text-dark">Processing</span>

                    <% } else if(item.status === "Shipped"){ %>
                        <span class="badge bg-info">Shipped</span>

                    <% } else if(item.status === "Out For Delivery"){ %>
                        <span class="badge bg-primary">Out For Delivery</span>

                    <% } else if(item.status === "Delivered"){ %>
                        <span class="badge bg-success">Delivered</span>

                    <% } else if(item.status === "Cancelled"){ %>
                        <span class="badge bg-danger">Cancelled</span>

                    <% } else if(item.status === "Return Requested" || (item.returnStatus && item.returnStatus.toLowerCase().trim() === 'requested')){ %>
                        <span class="badge bg-warning text-dark">Return Requested</span>

                    <% } else if(item.status === "Returned" || (item.returnStatus && item.returnStatus.toLowerCase().trim() === 'approved')){ %>
                        <span class="badge bg-success">Returned</span>
                    <% } %>

                    <% if(item.returnReason){ %>
                        <div class="mt-2">
                            <small class="text-danger">
                                Return Reason:
                                <%= item.returnReason %>
                            </small>
                        </div>
                    <% } %>

                    <% if(item.cancelReason){ %>
                        <div class="mt-2">
                            <small class="text-danger">
                                Cancel Reason:
                                <%= item.cancelReason %>
                            </small>
                        </div>
                    <% } %>

                </div>

            </div>

        </div>

    </div>
<!-- 
    <% if(order.orderStatus === "Placed" || order.orderStatus === "Processing"){ %>

    <div class="card mt-4">

        <div class="card-body">

            <h5 class="mb-3">
                Cancel Entire Order
            </h5>

            <form
                action="/orders/<%= order._id %>/cancel"
                method="POST"
            >

                <textarea
                    name="reason"
                    class="form-control mb-3"
                    placeholder="Reason (optional)"
                ></textarea>

                <button
                    type="submit"
                    class="btn btn-danger"
                >
                    Cancel Order
                </button>

            </form>

        </div>

    </div>

    <% } %> -->

</div>
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form
                action="/orders/<%= order._id %>/product/<%= item._id %>/cancel"
                method="POST"
            >

                <div class="modal-header">
                    <h5 class="modal-title">
                        Cancel Product
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                    ></button>
                </div>

                <div class="modal-body">

                    <label class="form-label">
                        Reason for Cancellation
                    </label>

                    <select
                        name="reason"
                        class="form-select"
                        required
                    >
                        <option value="">
                            Select a reason
                        </option>

                        <option value="Changed my mind">
                            Changed my mind
                        </option>

                        <option value="Ordered by mistake">
                            Ordered by mistake
                        </option>

                        <option value="Found better price">
                            Found better price
                        </option>

                        <option value="Delivery taking too long">
                            Delivery taking too long
                        </option>

                        <option value="Other">
                            Other
                        </option>
                    </select>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                    >
                        Close
                    </button>

                    <button
                        type="submit"
                        class="btn btn-danger"
                    >
                        Confirm Cancellation
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</html>