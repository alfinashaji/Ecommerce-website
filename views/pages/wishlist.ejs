<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Wishlist</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  />

  <style>
    /* Exact product design token overrides from Listing Page */
    :root {
      --accent-color: #000;
    }

    body {
      background: #f8f9fa; /* Matches bg-light */
    }

    .product-card {
      border-radius: 0;
      transition: 0.2s;
      background: #fff;
      height: 100%;
    }

    .product-card:hover {
      transform: translateY(-3px);
    }

    .product-img-container {
      position: relative;
      width: 100%;
      padding-top: 125%; /* Perfect 4:5 Aspect Ratio */
      overflow: hidden;
    }

    .product-img-container img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .wishlist-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: white;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      transition: 0.3s;
      color: #dc3545; /* Red accent for selected state */
    }

    .wishlist-btn:hover {
      transform: scale(1.1);
    }

    .discount-badge {
      background-color: #f8d7da;
      color: #dc3545;
      padding: 2px 8px;
      font-weight: bold;
      font-size: 0.8rem;
    }

    .old-price {
      text-decoration: line-through;
      color: #adb5bd;
      font-size: 0.9rem;
    }

    .empty-box {
      height: 60vh;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction:column;
    }
  </style>
</head>

<body>

<%- include("../partials/navbar") %>

<div class="container-fluid py-5 px-5">
  <div class="px-5">
    <h2 class="mb-4 fw-bold">My Wishlist</h2>

    <% if (wishlist && wishlist.products && wishlist.products.length > 0) { %>

      <div class="row">

        <% wishlist.products.forEach(product => { 
          // Replicating calculation logics from listing page
          const basePrice = product.variants?.length
            ? Math.min(...product.variants.map(v => v.price || 0))
            : 0;

          const finalPrice = product.variants?.length
            ? Math.min(...product.variants.map(v => v.finalPrice || v.price))
            : 0;

          const hasOffer = finalPrice < basePrice;
          const discount = product.category?.discount;
          let discountText = "";

          if (hasOffer && discount) {
            if (discount.type === "percentage") {
              discountText = `-${discount.value}%`;
            } else {
              discountText = `-₹${discount.value}`;
            }
          }

          const img = product.variants?.[0]?.images?.[0] || "";
        %>

          <!-- Standardized layout widths matching your design rhythm -->
          <div class="col-md-4 col-lg-3 mb-4">
            <a href="/products/<%= product._id %>" class="text-decoration-none text-dark">
              <div class="card product-card border-0 shadow-sm">
                
                <div class="product-img-container">
                  <img src="<%= img %>" alt="<%= product.name %>">
                  
                  <!-- Remove button located directly over the graphic container -->
                  <button 
                    class="wishlist-btn" 
                    onclick="event.preventDefault(); removeWishlist('<%= product._id %>')"
                    title="Remove from wishlist"
                  >
                    <i class="fa-solid fa-heart"></i>
                  </button>
                </div>

                <div class="p-3">
                  <h5 class="fw-bold mb-1" style="font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= product.name %>
                  </h5>
                  
                  <p class="text-muted mb-2" style="font-size: 0.8rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                    <%= product.description || "No description available." %>
                  </p>

                 <div class="d-flex justify-content-between align-items-center">
  <div>
    <div class="fw-bold text-dark" style="font-size: 1.1rem;">
      ₹<%= finalPrice %>
    </div>

    <% if (hasOffer) { %>
      <div class="old-price">₹<%= basePrice %></div>
    <% } %>
  </div>

  <% if (hasOffer) { %>
    <div class="discount-badge"><%= discountText %></div>
  <% } %>
</div>

<button
  class="btn btn-dark w-100 mt-3"
 onclick="event.preventDefault(); addToCart(
  '<%= product._id %>',
  '<%= product.variants[0].size %>',
  '<%= product.variants[0].color %>'
)"
>
  Add To Cart
</button>
                </div>

              </div>
            </a>
          </div>

        <% }) %>

      </div>

    <% } else { %>

      <div class="empty-box">
        <i class="fa-regular fa-heart mb-3" style="font-size:70px; color:#999;"></i>
        <h3 class="fw-bold">Your wishlist is empty</h3>
        <a href="/products" class="btn btn-dark mt-3 py-2 px-4 fw-bold" style="border-radius: 0;">
          CONTINUE SHOPPING
        </a>
      </div>

    <% } %>
  </div>
</div>

<%- include("../partials/footer") %>

<script>
async function removeWishlist(productId) {
  try {
    const res = await fetch(`/wishlist/remove/${productId}`, {
      method: "DELETE"
    });

    const data = await res.json();

    if (data.success) {
      location.reload();
    }
  } catch (err) {
    console.error("Error removing item from wishlist:", err);
    alert("Could not remove item. Please try again.");
  }
}

async function addToCart(productId, size, color) {
  try {

    const res = await fetch(`/cart/add/${productId}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        size,
        color,
      }),
    });

    const data = await res.json();

    if (data.success) {
      location.reload();
    } else {
      alert(data.message || "Cart failed");
    }

  } catch (err) {
    console.log(err);
    alert("Error adding to cart");
  }
}
</script>

</body>
</html>