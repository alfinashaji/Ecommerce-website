<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - <%= order.orderId %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --text-main: #1e293b;  
            --text-muted: #64748b;      
            --accent: #0f766e;          
            --accent-bg: #f0fdfa;       
            --border-light: #e2e8f0;   
            --bg-card: #ffffff;
            --bg-body: #f8fafc;     
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
        }

        .invoice-box {
            max-width: 850px;
            margin: 50px auto;
            background: var(--bg-card);
            padding: 60px;
            border-radius: 20px;
            border: 1px solid var(--border-light);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.01), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
        }

        .invoice-header {
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 35px;
            margin-bottom: 40px;
        }

        .invoice-title {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text-main);
        }

        .invoice-logo img {
            max-height: 55px;
            width: auto;
            object-fit: contain;
        }

        .section-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 16px;
        }

        .info-card {
            background: #ffffff;
            border: 1px solid var(--border-light);
            border-radius: 12px;
            padding: 24px;
            height: 100%;
        }

        .table-responsive {
            border: 1px solid var(--border-light);
            border-radius: 12px;
            overflow: hidden;
            margin-top: 20px;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background-color: #fdfdfd;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.8px;
            padding: 16px 24px;
            border-bottom: 1px solid var(--border-light);
        }

        .table tbody td {
            padding: 18px 24px;
            color: var(--text-main);
            font-size: 0.95rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .total-block {
            background-color: var(--accent-bg);
            border: 1px solid #ccfbf1;
            border-radius: 12px;
            padding: 20px 28px;
            display: inline-block;
            min-width: 300px;
        }

        .total-label {
            font-size: 0.95rem;
            color: var(--accent);
            font-weight: 600;
        }

        .total-amount {
            font-size: 1.5rem;
            color: var(--accent);
            font-weight: 800;
        }

        .btn-download {
            background-color: var(--text-main);
            color: #ffffff;
            font-weight: 500;
            padding: 11px 26px;
            border-radius: 10px;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-download:hover {
            background-color: #020617;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .btn-back {
            background-color: #ffffff;
            color: var(--text-muted);
            font-weight: 500;
            padding: 11px 26px;
            border-radius: 10px;
            border: 1px solid var(--border-light);
            transition: all 0.2s ease;
        }

        .btn-back:hover {
            background-color: #f8fafc;
            color: var(--text-main);
            border-color: #cbd5e1;
        }

        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white;
            }
            .invoice-box {
                box-shadow: none;
                margin: 0;
                padding: 0;
                width: 100%;
                border: none;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="invoice-box">
        
        <div class="invoice-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="invoice-title mb-2">Invoice</h1>
                <p class="text-muted mb-1" style="font-size: 0.95rem;">
                    Order Reference: <span class="fw-semibold text-dark"><%= order.orderId %></span>
                </p>
                <p class="text-muted small mb-0">
                    <i class="bi bi-calendar3 me-1"></i> Issued: <%= new Date(order.createdAt).toLocaleDateString() %>
                </p>
            </div>
            <div class="invoice-logo text-md-end">
                <a href="/home">
                    <img src="/images/logo.png" alt="logo" />
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="info-card">
                    <div class="section-title">Invoiced To</div>
                    <p class="fw-bold mb-1" style="font-size: 1.05rem;"><%= order.address.name %></p>
                    <p class="text-muted small mb-3"><i class="bi bi-telephone me-1"></i> <%= order.address.phone %></p>
                    <p class="text-secondary mb-0 small" style="line-height: 1.6;">
                        <%= order.address.street %><br>
                        <%= order.address.city %>, <%= order.address.state %> - <span class="fw-medium text-dark"><%= order.address.pincode %></span>
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <div class="section-title">Payment Architecture</div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted small">Method:</span>
                        <span class="fw-semibold small text-dark"><%= order.paymentMethod %></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Status:</span>
                        <%
const allDelivered =
  order.products &&
  order.products.every(item => item.status === "Delivered");
%>

<% if (allDelivered) { %>
    <span class="badge bg-success-subtle text-success px-2 py-1" style="font-weight: 600;">
        Paid
    </span>
<% } else { %>
    <span class="badge bg-warning-subtle text-dark px-2 py-1" style="font-weight: 600;">
        <%= order.paymentStatus %>
    </span>
<% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="my-5">
            <div class="section-title">Line Items</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Product Details</th>
                            <th scope="col" class="text-center" style="width: 12%;">Qty</th>
                            <th scope="col" class="text-end" style="width: 20%;">Unit Price</th>
                            <th scope="col" class="text-end" style="width: 20%;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% let grandTotal = 0; %>
                        <% deliveredItems.forEach(item => { %>
                            <% const subtotal = item.finalPrice * item.quantity; %>
                            <% grandTotal += subtotal; %>
                            <tr>
                                <td>
                                    <span class="fw-semibold text-dark"><%= item.productName %></span>
                                </td>
                                <td class="text-center text-secondary fw-medium"><%= item.quantity %></td>
                                <td class="text-end text-secondary">₹<%= item.finalPrice.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td class="text-end fw-bold text-dark">₹<%= subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-end mb-5">
            <div class="total-block text-start">
                <div class="d-flex justify-content-between align-items-center gap-5">
                    <span class="total-label">Amount Paid</span>
                    <span class="total-amount">₹<%= grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                </div>
            </div>
        </div>

        <hr style="color: var(--border-light); opacity: 0.7;">

        <div class="text-center mt-4">
            <p class="text-muted small mb-0" style="letter-spacing: 0.2px;">Thank you for your valuable association with our store.</p>
        </div>

        <div class="text-center mt-5 gap-3 d-flex justify-content-center no-print">
            <a href="/orders/<%= order._id %>/invoice/download" class="btn btn-download d-inline-flex align-items-center gap-2">
                <i class="bi bi-download"></i> Download Invoice PDF
            </a>
            <a href="/orders" class="btn btn-back d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
        </div>

    </div>
</div>

</body>
</html>