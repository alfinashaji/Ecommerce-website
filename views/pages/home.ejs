<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Commerce Home</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <!-- Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet"/>
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: #f5f5f5;
    }

    /* HERO */
    .hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #9fbfc1;
      padding: 80px 100px;
      min-height: 100vh;
    }

    .hero-text h1 {
      font-size: 60px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .hero-text p {
      margin-bottom: 30px;
    }

    .hero-text button {
      padding: 12px 28px;
      background: #000;
      color: #fff;
      border: none;
      cursor: pointer;
      transition: 0.3s;
    }

    .hero-img img {
      width: 420px;
      border-radius: 40px;
    }

    /* PRODUCTS GRID */
    .best-section, .tabs-section {
      padding: 60px 80px;
    }

    .best-section {
      text-align: center;
      padding-bottom: 0;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 30px;
      margin-top: 40px;
    }

    .card {
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      text-align: left;
      border: none !important;
      transition: transform 0.3s ease;
      height: 100%;
    }
    
    .card:hover {
      transform: translateY(-5px);
    }

    .img-box {
      position: relative;
    }

    .img-box img {
      width: 100%;
      height: 300px;
      object-fit: cover;
    }

    .wishlist {
      position: absolute;
      top: 10px;
      right: 10px;
      background: #fff;
      padding: 8px;
      border-radius: 50%;
      cursor: pointer;
      color: #000;
    }

    .card h4 {
      padding: 15px 15px 0 15px;
      font-size: 16px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Description Styling */
    .desc {
      padding: 0 15px;
      font-size: 13px;
      color: #777;
      height: 40px;
      overflow: hidden;
      margin-bottom: 10px;
    }

    .price-row {
      padding: 10px 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .price {
      color: #000;
      font-weight: bold;
    }

    .offer {
      background: #f8d7da;
      color: red;
      padding: 2px 6px;
      font-size: 12px;
      font-weight: bold;
    }

    .bottom-row {
      display: flex;
      justify-content: space-between;
      padding: 0 15px 15px 15px;
    }

    .see-all {
      margin-top: 30px;
      padding: 10px 25px;
      border: 1px solid #000;
      background: transparent;
      text-decoration: none;
      color: #000;
      display: inline-block;
    }

    /* TABS CUSTOM STYLING */
    .nav-tabs {
      display: flex;
      justify-content: center;
      border: none;
    }

    .nav-tabs .nav-link {
      border: none !important;
      background: none !important;
      color: #999;
      font-weight: 600;
      text-transform: capitalize;
    }

    .nav-tabs .nav-link.active {
      color: #000;
      border-bottom: 2px solid black !important;
    }

    /* FEATURES */
    .feature-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #ebebeb;
      gap: 60px;
      padding: 60px 0;
    }

    .feature-item {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .feature-item i {
      height: 60px;
      width: 60px;
      font-size: 25px;
      color: #000;
      background: #9fbfc1;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  </style>
</head>

<body>


  <%- include("../partials/navbar") %>


  <section class="hero">
    <div class="hero-text">
      <h1>Discover and <br>Find Your Own Fashion!</h1>
      <p>Explore our curated collection of stylish clothing and accessories tailored to your unique taste.</p>
      <button onclick="window.location.href='/products'">EXPLORE NOW</button>
    </div>

    <div class="hero-img">
      <img src="/images/banner-image1.png" alt="Hero Banner" />
    </div>
  </section>


  <section class="best-section">
    <h2>Best Selling</h2>
    <p>Get in on the trend with our curated selection.</p>

    <div class="products">
      <% if(products && products.length > 0) { %>
        <% products.slice(0, 4).forEach(product => { %>
          <div class="card shadow-sm">
            <div class="img-box">
              <a href="/products/<%= product._id %>">
                <img src="<%= product.variants && product.variants[0]?.images[0] %>" alt="<%= product.name %>" />
              </a>
             <i
  class="fa-regular fa-heart wishlist"
  onclick="toggleWishlist('<%= product._id %>', this)"
></i>
            </div>
            <h4><%= product.name %></h4>
            
            <p class="desc"><%= product.description %></p>
            
            <div class="price-row">
              <span class="price">₹<%= product.variants[0]?.finalPrice %></span>
              <% if(product.variants[0]?.finalPrice < product.variants[0]?.price) { %>
                <span class="offer">OFFER</span>
              <% } %>
            </div>
            <div class="bottom-row">
              <span style="text-decoration: line-through; color: #999; font-size: 13px;">
                <%= product.variants[0]?.finalPrice < product.variants[0]?.price ? '₹' + product.variants[0]?.price : '' %>
              </span>
              <i
  class="fa-solid fa-cart-shopping"
  style="cursor:pointer"
  onclick="addToCart('<%= product._id %>')"
></i>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
    <a href="/products" class="see-all">See all →</a>
  </section>

  
  <section class="tabs-section">
    <h2 class="mb-5 text-center">Our Products</h2>

    <% 
     
      const uniqueCategories = [];
      const catMap = new Map();
      if(products && products.length > 0) {
        products.forEach(item => {
          if(item.category && !catMap.has(item.category._id.toString())){
              catMap.set(item.category._id.toString(), true);
              uniqueCategories.push({
                  id: item.category._id.toString(),
                  name: item.category.name
              });
          }
        });
      }
    %>

    <!-- Navigation Buttons -->
    <ul class="nav nav-tabs mb-4" id="dynamicProductTabs" role="tablist">
      <% uniqueCategories.forEach((cat, index) => { %>
        <li class="nav-item" role="presentation">
          <button 
            class="nav-link <%= index === 0 ? 'active' : '' %>" 
            id="btn-<%= cat.id %>"
            data-bs-toggle="tab" 
            data-bs-target="#pane-<%= cat.id %>" 
            type="button" 
            role="tab">
            <%= cat.name %>
          </button>
        </li>
      <% }) %>
    </ul>

    <!-- Tab Panes -->
    <div class="tab-content">
      <% uniqueCategories.forEach((cat, index) => { %>
        <div 
          class="tab-pane fade <%= index === 0 ? 'show active' : '' %>" 
          id="pane-<%= cat.id %>" 
          role="tabpanel">
          
          <div class="products">
            <% 
             
              let catSpecificProducts = products.filter(p => 
                p.category && p.category._id.toString() === cat.id
              ).slice(0, 4); 
            %>

            <% if(catSpecificProducts.length > 0) { %>
              <% catSpecificProducts.forEach(product => { %>
               
                <div class="card shadow-sm">
                  <div class="img-box">
                    <a href="/products/<%= product._id %>">
                      <img src="<%= product.variants[0]?.images[0] %>" alt="<%= product.name %>" />
                    </a>
                    <i
  class="fa-regular fa-heart wishlist"
  onclick="toggleWishlist('<%= product._id %>', this)"
></i>
                  </div>
                  <h4><%= product.name %></h4>
                  <p class="desc"><%= product.description %></p>
                  
                  <div class="price-row">
                    <span class="price">₹<%= product.variants[0]?.finalPrice %></span>
                    <% if(product.variants[0]?.finalPrice < product.variants[0]?.price) { %>
                      <span class="offer">OFFER</span>
                    <% } %>
                  </div>

                  <div class="bottom-row">
                    <span style="text-decoration: line-through; color: #999; font-size: 13px;">
                      <%= product.variants[0]?.finalPrice < product.variants[0]?.price ? '₹' + product.variants[0]?.price : '' %>
                    </span>
                   <i
  class="fa-solid fa-cart-shopping"
  style="cursor:pointer"
  onclick="addToCart('<%= product._id %>')"
></i>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-center w-100">No products in this category.</p>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="feature-split mb-5">
    <div class="feature-item justify-content-end">
      <div class="d-flex gap-4">
        <i class="fa fa-truck"></i>
        <div>
          <h4>Free Delivery</h4>
          <p>Fast and free delivery on all orders</p>
        </div>
      </div>
    </div>
    <div class="feature-item justify-content-start">
      <div class="d-flex gap-4">
        <i class="fa fa-headset"></i>
        <div>
          <h4>24/7 Support</h4>
          <p>Always here to help you anytime</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <%- include("../partials/footer") %>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function toggleWishlist(productId, element) {
  try {
    const res = await fetch(`/wishlist/toggle/${productId}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      }
    });

    const data = await res.json();

    if (data.added) {
      element.classList.remove("fa-regular");
      element.classList.add("fa-solid");
    } else {
      element.classList.remove("fa-solid");
      element.classList.add("fa-regular");
    }
  } catch (err) {
    console.error(err);
  }
}

async function addToCart(productId) {
  try {
    const res = await fetch(`/cart/add/${productId}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      }
    });

    const data = await res.json();

    if (data.success) {
      alert("Product added to cart");
    }
  } catch (err) {
    console.error(err);
  }
}
</script>
</body>
</html>