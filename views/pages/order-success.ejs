<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmed</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    .success-icon {
      font-size: 5rem;
      color: #198754;
      animation: scaleUp 0.4s ease-out forwards;
    }
    @keyframes scaleUp {
      0% { transform: scale(0.7); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body class="bg-white">

<%- include("../partials/navbar") %>

<div class="container py-5 text-center">
  <div class="row justify-content-center my-5">
    <div class="col-md-6">
      
      <div class="mb-4">
        <i class="bi bi-check-circle-fill success-icon"></i>
      </div>

      <h1 class="text-uppercase fw-normal tracking-wide mb-2 fs-2">Thank You for Your Purchase!</h1>
      <p class="text-muted mb-4 px-3">Your order has been logged successfully and will be delivered shortly. Cash payment will be collected at your doorstep.</p>
      
      <% if (orderId) { %>
        <div class="bg-light p-3 rounded-0 border mb-5">
          <span class="small text-secondary tracking-wider text-uppercase d-block mb-1">Reference ID</span>
          <span class="font-monospace fw-bold text-dark"><%= orderId %></span>
        </div>
      <% } %>

      <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center align-items-center">
        <a href="/orders" class="btn btn-dark rounded-0 px-4 py-3 text-uppercase fw-bold tracking-wider w-100 style-fix">
          Track Order
        </a>
        <a href="/shop" class="btn btn-outline-dark rounded-0 px-4 py-3 text-uppercase fw-bold tracking-wider w-100">
          Continue Shopping
        </a>
      </div>

    </div>
  </div>
</div>

<%- include("../partials/footer") %>
</body>
</html>