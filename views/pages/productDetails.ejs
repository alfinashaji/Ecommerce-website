<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name %></title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Drift Zoom CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/drift-zoom/dist/drift-basic.min.css"
    />

    <!-- Drift Zoom JS -->
    <script src="https://cdn.jsdelivr.net/npm/drift-zoom/dist/Drift.min.js"></script>

    <style>
      :root {
        --text-main: #000000;
        --text-muted: #666666;
        --bg-light: #f9f9f9;
        --border-color: #eeeeee;
      }

      body {
        background: #ffffff;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
      }

      /* Breadcrumb Styling */
      .breadcrumb-nav {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .breadcrumb-nav a {
        color: var(--text-muted);
        text-decoration: none;
      }

      /* Layout */
      .product-container {
        max-width: 1300px;
        margin: 0 auto;
      }

      .product-box {
        background: white;
        border: none;
        position: relative;
        display: flex;
        align-items: stretch;
        overflow: visible !important; /* Required for Zoom Pane to show */
      }

      /* Left Side: Images */
      .main-img-container {
        position: relative;
        background-color: var(--bg-light);
        width: 100%;
        height: 600px; 
        display: flex;
        align-items: center;
        justify-content: center;
        /* Removed overflow:hidden to allow zoom pane visibility */
      }

      .main-img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        display: block;
        cursor: crosshair;
        object-fit: contain;
      }

      .thumb-container {
        gap: 10px;
        margin-top: 15px;
      }

      .thumb {
        width: 80px;
        height: 100px;
        object-fit: cover;
        cursor: pointer;
        border: 1px solid transparent;
        transition: border 0.2s ease;
      }
      .thumb:hover {
        border: 1px solid var(--text-main);
      }

      /* Right Side: Details */
      .right-panel {
        padding: 60px;
        height: 600px; 
        border-left: 1px solid var(--border-color);
        background: white;
        
      }

      .product-title {
        font-size: 18px;
        letter-spacing: 1.5px;
        font-weight: 500;
        margin-bottom: 8px;
        text-transform: uppercase;
      }

      .price {
        font-size: 16px;
        font-weight: 400;
        margin-bottom: 25px;
      }

      .description {
        font-size: 13px;
        line-height: 1.8;
        color: #333;
        margin-bottom: 40px;
        max-width: 400px;
      }

      .section-label {
        font-size: 11px;
        color: var(--text-muted);
        margin-bottom: 12px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .color-box {
        width: 40px;
        height: 40px;
        display: inline-block;
        margin-right: 8px;
        cursor: pointer;
        border: 1px solid #ddd;
        transition: transform 0.2s ease;
      }
      .color-box.active {
        border: 2px solid #000;
        transform: scale(1.05);
      }

      .size-box {
        border: 1px solid #ddd;
        width: 55px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 8px;
        margin-bottom: 8px;
        cursor: pointer;
        font-size: 11px;
        transition: all 0.2s ease;
      }
      .size-box.active {
        border: 1px solid #000;
        background: #000;
        color: #fff;
      }

      .stock-status {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 20px;
        display: block;
      }

      .btn-action {
        width: 100%;
        height: 55px;
        border: none;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 0;
        transition: all 0.3s ease;
      }

      .btn-cart {
        background: #eeeeee;
        color: #000;
        margin-bottom: 10px;
      }
      .btn-cart:hover:not(:disabled) {
        background: #e0e0e0;
      }

      .btn-buy {
        background: #000;
        color: #fff;
      }
      .btn-buy:hover:not(:disabled) {
        background: #333;
      }

      .btn-out-of-stock {
        background: #f5f5f5 !important;
        color: #aaaaaa !important;
        cursor: not-allowed !important;
        border: 1px solid #eeeeee !important;
        text-decoration: line-through;
        opacity: 0.8;
      }

      /* Fixed Zoom Pane */
      #zoomPane {
        position: absolute;
        top: 0;
        left: 100%; 
        width: 100%; 
        height: 600px;
        background: #fff;
        border: 1px solid var(--border-color);
        z-index: 9999;
        display: none;
        pointer-events: none;
      }

      @media (max-width: 992px) {
        .product-box { display: block; }
        .main-img-container {
          height: auto;
          max-height: 500px;
        }
        .right-panel {
          height: auto;
          padding: 30px 15px;
          border-left: none;
        }
        #zoomPane {
          display: none !important;
        }
      }
    </style>
  </head>

  <body>
    <%- include("../partials/navbar") %>
    <div class="container-fluid product-container mt-4">
      <nav class="breadcrumb-nav mb-4 ps-md-4">
        <a href="/home">Home</a> / <a href="/products">Shop</a> /
        <span><%= product.category?.name %></span> /
        <span class="text-dark fw-bold"><%= product.name %></span>
      </nav>

      <div class="row g-0 product-box">
        <!-- LEFT: IMAGES -->
        <div class="col-lg-7">
          <div class="main-img-container">
            <img
              id="mainImage"
              src="<%= product.variants[0]?.images[0] %>"
              data-zoom="<%= product.variants[0]?.images[0] %>"
              class="main-img"
              alt="<%= product.name %>"
            />
            <div id="zoomPane"></div>
          </div>
          <div id="thumbContainer" class="d-flex flex-wrap thumb-container ps-md-0">
            <!-- Thumbnails injected by JS -->
          </div>
        </div>

        <!-- RIGHT: PRODUCT INFO -->
        <div class="col-lg-5">
          <div class="right-panel">
            <h1 class="product-title"><%= product.name %></h1>
            <div class="price" id="price"></div>
            <div class="description"><%= product.description %></div>

            <div class="variant-selection">
              <span class="section-label">Color</span>
              <div id="colorContainer" class="mb-4"></div>

              <span class="section-label">Size</span>
              <div id="sizeContainer" class="mb-4"></div>
            </div>

            <div id="stockText"></div>

            <div class="action-buttons mt-4">
              <button id="addToCartBtn" class="btn btn-action btn-cart" onclick="addToCart()">
                Add to cart
              </button>
              <button id="buyNowBtn" class="btn btn-action btn-buy" onclick="buyNow()">
                Buy Now
              </button>
             <button
  class="btn btn-action"
  style="background:#fff;border:1px solid #ddd;"
  onclick="toggleWishlist()"
>
 Add to Wishlist
</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RELATED PRODUCTS SECTION -->
    <div class="container product-container mt-5 pt-5 border-top">
      <h3 class="product-title mb-5 text-center" style="font-size: 20px; letter-spacing: 2px;">Related Products</h3>
      <div class="row">
        <% if (relatedProducts && relatedProducts.length > 0) { %>
          <% relatedProducts.forEach(item => { %>
            <div class="col-6 col-md-3 mb-4">
              <a href="/products/<%= item._id %>" class="text-decoration-none text-dark">
                <div class="product-box border-0" style="display: block;">
                  <div class="main-img-container" style="padding-top: 125%; height: auto; position: relative; overflow: hidden; background: #f9f9f9;">
                    <img src="<%= item.variants[0]?.images[0] %>" 
                         class="position-absolute top-0 start-0 w-100 h-100" 
                         style="object-fit: cover; transition: transform 0.3s ease;" 
                         onmouseover="this.style.transform='scale(1.05)'"
                         onmouseout="this.style.transform='scale(1)'"
                         alt="<%= item.name %>">
                  </div>
                  <div class="mt-3">
                    <div style="font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 1px;"><%= item.brand?.name || 'Brand' %></div>
                    <div class="fw-bold" style="font-size: 13px; text-transform: uppercase; margin: 4px 0;"><%= item.name %></div>
                    <div class="d-flex align-items-center gap-2">
                      <span class="fw-bold" style="font-size: 14px;">₹<%= item.variants[0]?.finalPrice.toLocaleString() %></span>
                      <% if (item.variants[0]?.finalPrice < item.variants[0]?.price) { %>
                        <span class="text-muted text-decoration-line-through" style="font-size: 12px;">₹<%= item.variants[0]?.price.toLocaleString() %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <p class="text-muted" style="font-size: 13px;">No similar items found based on your preferences.</p>
          </div>
        <% } %>
      </div>
    </div>

    <%- include("../partials/footer") %>

    <script>
      const variants = JSON.parse(`<%- JSON.stringify(product?.variants || []) %>`);
      let driftInstance;
      let selectedVariantIndex = 0;

      function setupZoom() {
        if (driftInstance) { driftInstance.destroy(); }
        const img = document.querySelector("#mainImage");
        const pane = document.querySelector("#zoomPane");

        driftInstance = new Drift(img, {
          paneContainer: pane,
          inlinePane: false,
          hoverBoundingBox: true,
          sourceAttribute: "data-zoom",
          handleTouch: true,
          zoomFactor: 3
        });

        img.addEventListener("mouseenter", () => { pane.style.display = "block"; });
        img.addEventListener("mouseleave", () => { pane.style.display = "none"; });
      }

      function init() {
        renderColors();
        renderSizes();
        selectVariant(0);
      }

      function renderColors() {
        const box = document.getElementById("colorContainer");
        box.innerHTML = "";
        variants.forEach((v, i) => {
          box.innerHTML += `<div class="color-box" style="background:${v.color}" onclick="selectVariant(${i})" data-index="${i}"></div>`;
        });
      }

      function renderSizes() {
        const box = document.getElementById("sizeContainer");
        box.innerHTML = "";
        variants.forEach((v, i) => {
          box.innerHTML += `<span class="size-box" onclick="selectVariant(${i})" data-index="${i}">${v.size.toUpperCase()}</span>`;
        });
      }

      function selectVariant(index) {
        selectedVariantIndex = index;
        const v = variants[index];
        const mainImg = document.getElementById("mainImage");

        mainImg.src = v.images[0];
        mainImg.setAttribute("data-zoom", v.images[0]);

        const thumbBox = document.getElementById("thumbContainer");
        thumbBox.innerHTML = "";
        v.images.forEach((img) => {
          thumbBox.innerHTML += `<img src="${img}" class="thumb" onclick="changeImage('${img}')">`;
        });

        const priceBox = document.getElementById("price");

if (v.finalPrice < v.price) {
  priceBox.innerHTML = `
    <span style="font-size:22px;font-weight:bold;">
      ₹${v.finalPrice.toLocaleString()}
    </span>

    <span style="
      text-decoration: line-through;
      color: #888;
      margin-left: 10px;
      font-size: 15px;
    ">
      ₹${v.price.toLocaleString()}
    </span>

    <span style="
      background:#f8d7da;
      color:#dc3545;
      padding:2px 8px;
      margin-left:10px;
      font-size:12px;
      font-weight:bold;
    ">
      OFFER
    </span>
  `;
} else {
  priceBox.innerHTML = `
    <span style="font-size:22px;font-weight:bold;">
      ₹${v.price.toLocaleString()}
    </span>
  `;
}

        const cartBtn = document.getElementById("addToCartBtn");
        const buyBtn = document.getElementById("buyNowBtn");
        const stockText = document.getElementById("stockText");

        if (v.stock > 0) {
          stockText.innerHTML = '<span class="stock-status text-success">● In Stock</span>';
          cartBtn.disabled = false;
          cartBtn.innerText = "Add to cart";
          cartBtn.classList.remove("btn-out-of-stock");
          buyBtn.disabled = false;
          buyBtn.innerText = "Buy Now";
          buyBtn.classList.remove("btn-out-of-stock");
        } else {
          stockText.innerHTML = '<span class="stock-status text-danger">○ Out of Stock</span>';
          cartBtn.disabled = true;
          cartBtn.innerText = "Sold Out";
          cartBtn.classList.add("btn-out-of-stock");
          buyBtn.disabled = true;
          buyBtn.innerText = "Currently Unavailable";
          buyBtn.classList.add("btn-out-of-stock");
        }

        document.querySelectorAll(".color-box").forEach((el) => el.classList.remove("active"));
        document.querySelectorAll(`.color-box[data-index="${index}"]`).forEach((el) => el.classList.add("active"));
        document.querySelectorAll(".size-box").forEach((el) => el.classList.remove("active"));
        document.querySelectorAll(`.size-box[data-index="${index}"]`).forEach((el) => el.classList.add("active"));

        setupZoom();
      }

      function changeImage(imgUrl) {
        const mainImg = document.getElementById("mainImage");
        mainImg.src = imgUrl;
        mainImg.setAttribute("data-zoom", imgUrl);
        setupZoom();
      }

     async function addToCart() {
  const variant = variants[selectedVariantIndex];

  try {
    const res = await fetch(`/cart/add/<%= product._id %>`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        size: variant.size,
        color: variant.color,
        quantity: 1
      })
    });

    const data = await res.json();

    if (data.success) {
      alert("Product added to cart");
    } else {
      alert(data.message);
    }
  } catch (err) {
    console.error(err);
  }
}
      async function buyNow() {
  const variant = variants[selectedVariantIndex];

  try {
    const res = await fetch(`/cart/add/<%= product._id %>`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        size: variant.size,
        color: variant.color,
        quantity: 1
      })
    });

    const data = await res.json();

    if (data.success) {
      window.location.href = "/cart";
    }
  } catch (err) {
    console.error(err);
  }
}

      window.onload = init;

      async function toggleWishlist() {
  try {
    const res = await fetch(`/wishlist/toggle/<%= product._id %>`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      }
    });

    const data = await res.json();

    if (data.added) {
      alert("Added to wishlist");
    } else {
      alert("Removed from wishlist");
    }
  } catch (err) {
    console.error(err);
  }
}
    </script>
  </body>
</html>