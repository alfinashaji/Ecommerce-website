<!DOCTYPE html>
<html>
  <head>
    <title>Verify OTP</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="box">
      <div class="d-flex align-items-center gap-2 mb-5">
        <img src="/images/Logo.png" class="logo" alt="logo" />
        <strong>GLAMORA</strong>
      </div>

      <p>
        Enter the 6-digit OTP sent to<br />
        <strong><%= email %></strong>
      </p>

      <% if (success) { %>
      <div class="alert alert-success text-center">
        <%= success %>
      </div>
      <% } %>

      <% if (error) { %>
      <div class="alert alert-danger text-center">
        <%= error %>
      </div>
      <% } %>

      <!-- OTP FORM -->
      <form action="/api/auth/verify-otp" method="POST" id="otpForm">
        <input type="hidden" name="email" value="<%= email %>" />

        <div class="otp-container">
          <input type="text" maxlength="1" class="otp-input" />
          <input type="text" maxlength="1" class="otp-input" />
          <input type="text" maxlength="1" class="otp-input" />
          <input type="text" maxlength="1" class="otp-input" />
          <input type="text" maxlength="1" class="otp-input" />
          <input type="text" maxlength="1" class="otp-input" />
        </div>

        <!-- hidden real otp -->
        <input type="hidden" name="otp" id="otpValue" />

        <div class="timer">
          Resend OTP in <span id="countdown">0</span>s
        </div>

        <button type="submit" class="btn btn-custom">Submit</button>
      </form>

      <!-- RESEND -->
      <form action="/api/auth/resend-otp" method="POST" class="mb-5" id="resendForm">
        <input type="hidden" name="email" value="<%= email %>" />
        <button id="resendBtn" class="resend-btn" disabled>Resend OTP</button>
      </form>
    </div>

    <script>
      // Otp input handle
      const inputs = document.querySelectorAll(".otp-input");
      const otpValue = document.getElementById("otpValue");

      inputs.forEach((input, index) => {
        input.addEventListener("input", () => {
          if (input.value && index < inputs.length - 1) {
            inputs[index + 1].focus();
          }

          let otp = "";
          inputs.forEach((i) => (otp += i.value));
          otpValue.value = otp;
        });

        input.addEventListener("keydown", (e) => {
          if (e.key === "Backspace" && !input.value && index > 0) {
            inputs[index - 1].focus();
          }
        });
      });

      // Timer
    const countdown = document.getElementById("countdown");
const resendBtn = document.getElementById("resendBtn");

const otpExpiry = Number("<%= otpExpiry || 0 %>");

function updateTimer() {
  const now = Date.now();
  const timeLeft = Math.max(0, Math.floor((otpExpiry - now) / 1000));

  countdown.innerText = timeLeft;

  if (timeLeft > 0) {
    resendBtn.disabled = true;
  } else {
    resendBtn.disabled = false;
  }
}

updateTimer();

setInterval(updateTimer, 1000);

      // resendForm.addEventListener("submit", () => {
      //   localStorage.removeItem(storageKey);
      // });
    </script>
  </body>
</html>