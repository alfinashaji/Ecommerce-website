<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Admin Dashboard</title>

    <!-- Google Font -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Poppins", sans-serif;
      }

      body {
        display: flex;
        background: #f4f6f9;
      }

      .header {
        background: #fff;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .header h2 {
        font-weight: 600;
      }

      .logout-btn {
        padding: 8px 16px;
        border: 1px solid #000;
        background: transparent;
        cursor: pointer;
      }

      /* Cards */
      .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
      }

      .card {
        background: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
      }

      .card h4 {
        font-size: 14px;
        color: #777;
        margin-bottom: 10px;
      }

      .card h2 {
        font-size: 22px;
      }

      /* Chart Section */
      .chart-section {
        display: grid;
        grid-template-columns: 3fr 1fr;
        gap: 20px;
      }

      .chart,
      .top-category {
        background: #fff;
        padding: 20px;
        border-radius: 10px;
      }

      .bar {
        height: 10px;
        background: #cde7e6;
        margin-top: 10px;
        border-radius: 5px;
      }
      /* Main Content */
      .main {
        flex: 1;
        padding: 30px;
      }
    </style>
  </head>

  <body>
    <%- include("../partials/sidebar") %>
    <!-- Main Content -->
    <div class="main">
      <!-- Header -->
      <div class="header">
        <div>
          <h2>Dashboard</h2>
          <p>Welcome Alfina</p>
        </div>
        <button class="logout-btn">LOGOUT</button>
      </div>

      <!-- Cards -->
      <div class="cards">
        <div class="card">
          <h4>Total Orders</h4>
          <h2>247,384</h2>
        </div>
        <div class="card">
          <h4>Total Products</h4>
          <h2>836</h2>
        </div>
        <div class="card">
          <h4>Total Users</h4>
          <h2>836</h2>
        </div>
        <div class="card">
          <h4>Total Revenue</h4>
          <h2>₹50000</h2>
        </div>
      </div>

      <!-- Chart Section -->
      <div class="chart-section">
        <div class="chart">
          <h3>Sales Chart</h3>
          <p style="margin-top: 10px; color: #777">(Chart placeholder)</p>
        </div>

        <div class="top-category">
          <h3>Top selling category</h3>

          <p style="margin-top: 15px">GENTS</p>
          <div class="bar" style="width: 80%"></div>

          <p style="margin-top: 15px">WOMENS</p>
          <div class="bar" style="width: 60%"></div>
        </div>
      </div>
    </div>
  </body>
</html>
