<div class="table-container">

<table class="table table-hover">

<thead class="table-dark">
<tr>
    <th>Order ID</th>
    <th>Details</th>
    <th>Quantity</th>
    <th>Price</th>
    <th>Status</th>
    <th>Actions</th>
</tr>
</thead>

<tbody>

<% orders.forEach(order => { %>

  <% order.products.forEach(item => { %>

    <tr id="row-<%= item._id %>">

      <td><%= order.orderId %></td>

      <td>
        <img
          src="<%= item.productImage %>"
          width="50"
          height="50"
          style="object-fit: contain; margin-right: 8px;"
        >
        <%= item.productName %>
      </td>

      <td><%= item.quantity %></td>

      <td>₹<%= item.finalPrice %></td>

      <td class="status-cell">
        <span class="badge bg-info text-dark">
          <%= item.status %>
        </span>
      </td>

      <td>

        <a
  href="/admin/orders/<%= order._id %>/product/<%= item._id %>"
  class="btn btn-primary btn-sm"
>
  View
</a>

        <button
          class="btn btn-warning btn-sm"
          onclick="openEditModal(
  '<%= order._id %>',
  '<%= item._id %>',
  '<%= item.status %>'
)"
        >
          Edit
        </button>

      </td>

    </tr>

  <% }) %>

<% }) %>

</tbody>
</table>

<div class="d-flex justify-content-center mt-4">
<nav>
<ul class="pagination">

<% const buildUrl = (page) => {
    let url = `/admin/orders?page=${page}`;
    if (search) url += `&q=${search}`;
    if (selectedStatus) url += `&status=${selectedStatus}`;
    if (sort) url += `&sort=${sort}`;
    return url;
}; %>

<li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
    <a class="page-link" href="<%= buildUrl(currentPage - 1) %>">&laquo;</a>
</li>

<% for(let i = 1; i <= totalPages; i++) { %>
<li class="page-item <%= i === currentPage ? 'active' : '' %>">
    <a class="page-link" href="<%= buildUrl(i) %>"><%= i %></a>
</li>
<% } %>

<li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
    <a class="page-link" href="<%= buildUrl(currentPage + 1) %>">&raquo;</a>
</li>

</ul>
</nav>
</div>

</div>
</div>

<div class="modal fade" id="editOrderModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">

      <form id="editOrderForm">

        <div class="modal-header">
          <h5 class="modal-title">Update Order Status</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          
          <div id="modalErrorBox" class="alert alert-danger d-none"></div>

          <select name="status" id="statusSelect" class="form-select">
            <option value="Pending">Pending</option>
            <option value="Shipped">Shipped</option>
            <option value="Out For Delivery">Out For Delivery</option>
            <option value="Delivered">Delivered</option>
            <option value="Cancelled">Cancelled</option>
          </select>

        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" id="submitBtn" class="btn btn-success">Save</button>
        </div>

      </form>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
let currentTargetUrl = "";
let currentProductId = "";

function openEditModal(orderId, productId, currentStatus) {
  currentTargetUrl = `/admin/orders/${orderId}/product/${productId}/status`;
  currentProductId = productId;

  const errorBox = document.getElementById("modalErrorBox");
  errorBox.classList.add("d-none");
  errorBox.innerText = "";

  const statusSelect = document.getElementById("statusSelect");
  statusSelect.value = currentStatus;

  if (statusSelect.selectedIndex === -1) {
    statusSelect.value = "Pending";
  }

  const modalElement = document.getElementById("editOrderModal");
  const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
  modal.show();
}

document.getElementById("editOrderForm").addEventListener("submit", async function(e) {
  e.preventDefault();

  const submitBtn = document.getElementById("submitBtn");
  const errorBox = document.getElementById("modalErrorBox");
  const statusSelect = document.getElementById("statusSelect");
  const selectedStatus = statusSelect.value;

  submitBtn.disabled = true;
  errorBox.classList.add("d-none");

  try {
    const response = await fetch(currentTargetUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ status: selectedStatus })
    });

    const data = await response.json();

    if (!response.ok || data.error) {
      errorBox.innerText = data.error || "An unexpected error occurred.";
      errorBox.classList.remove("d-none");
    } else {
      const targetedRow = document.getElementById(`row-${currentProductId}`);
      if (targetedRow) {
        const badgeCell = targetedRow.querySelector(".status-cell");
        badgeCell.innerHTML = `<span class="badge bg-info text-dark">${selectedStatus}</span>`;
      }

      const modalElement = document.getElementById("editOrderModal");
      const modal = bootstrap.Modal.getInstance(modalElement);
      modal.hide();
    }
  } catch (err) {
    errorBox.innerText = "Network transmission failed. Please try again.";
    errorBox.classList.remove("d-none");
  } finally {
    submitBtn.disabled = false;
  }
});
</script>
</body>
</html>