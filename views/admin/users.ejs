<!DOCTYPE html>
<html>
<head>
  <title>Admin - Users</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <style>
    .pagination-wrapper {
  display: flex;
  justify-content: flex-end;   /* RIGHT SIDE like your image */
  align-items: center;
  gap: 10px;
  margin-top: 20px;
}

/* number buttons */
.page-number {
  width: 38px;
  height: 38px;
  display: flex;
  justify-content: center;
  align-items: center;

  border: 1px solid #ddd;
  border-radius: 8px;
  text-decoration: none;
  color: #333;
  font-weight: 500;
  background: #fff;
  transition: 0.2s;
}

.page-number:hover {
  background: #f0f0f0;
}

/* active page (blue like image) */
.active-page {
  background: #4f46e5;
  color: white;
  border-color: #4f46e5;
}

/* arrows */
.page-arrow {
  font-size: 20px;
  text-decoration: none;
  color: #333;
  padding: 0 10px;
}

.page-arrow:hover {
  color: #4f46e5;
}

.page-arrow.disabled {
  opacity: 0.4;
  pointer-events: none;
  cursor: not-allowed;
}
  </style>
</head>

<body style="display:flex; background:#f4f6f9;">

  <!-- Sidebar -->
  <%- include("../partials/sidebar") %>

  <!-- Main Content -->
  <div style="flex:1; padding:30px;">

    <h3>User Management</h3>

    <form method="GET" action="/admin/users" class="mb-3 d-flex gap-2">
      <input 
        type="text"
        name="search"
        class="form-control"
        placeholder="Search user..."
        value="<%= search %>"
      >

      <button class="btn btn-primary">Search</button>

      <a href="/admin/users?clear=true" class="btn btn-secondary">Clear</a>
      
    </form>

    <table class="table table-bordered bg-white">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Joined</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.fullName %></td>
            <td><%= user.email %></td>
            <td>
              <%= new Date(user.createdAt).toLocaleDateString('en-IN', {
                day:'2-digit',
                month:'short',
                year:'numeric'
              }) %>
            </td>

            <td>
              <span 
                id="status-<%= user._id %>"
                class="badge <%= user.status === 'active' ? 'bg-success' : 'bg-danger' %>"
              >
                <%= user.status %>
              </span>
            </td>

            <td>
              <button 
                id="btn-<%= user._id %>"
                class="btn btn-sm <%= user.status === 'active' ? 'btn-danger' : 'btn-success' %>"
                onclick="toggleStatus('<%= user._id %>')"
              >
                <%= user.status === 'active' ? 'Block' : 'Unblock' %>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
<!-- PAGINATION -->
<nav aria-label="Page navigation">
  <ul class="pagination justify-content-end">

    <!-- PREVIOUS -->
    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
      <a class="page-link" 
         href="?page=<%= currentPage - 1 %>&search=<%= search %>">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>

    <!-- PAGE NUMBERS -->
    <% for (let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" 
           href="?page=<%= i %>&search=<%= search %>">
          <%= i %>
        </a>
      </li>
    <% } %>

    <!-- NEXT -->
    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
      <a class="page-link" 
         href="?page=<%= currentPage + 1 %>&search=<%= search %>">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>

  </ul>
</nav>
  </div>

</body>
<script>

async function toggleStatus(userId) {

  // confirmation
  const confirmAction = confirm("Are you sure you want to change user status?");
  if (!confirmAction) return;

  try {
    const res = await fetch(`/admin/users/${userId}/status`, {
      method: "PATCH"
    });

    const result = await res.json();

    alert(result.message);

    // update UI without reload
    const btn = document.getElementById(`btn-${userId}`);
    const status = document.getElementById(`status-${userId}`);

    if (result.status === "blocked") {

      // update badge
      status.innerText = "blocked";
      status.className = "badge bg-danger";

      // update button
      btn.innerText = "Unblock";
      btn.className = "btn btn-sm btn-success";

    } else {

      status.innerText = "active";
      status.className = "badge bg-success";

      btn.innerText = "Block";
      btn.className = "btn btn-sm btn-danger";
    }

  } catch (err) {
    console.error(err);
    alert("Something went wrong");
  }
}
</script>
</html>