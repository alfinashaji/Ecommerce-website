<!DOCTYPE html>
<html>
  <head>
    <title>Product Management</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
    />
    <style>
      body {
        background-color: #f8f9fa;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
      .modal-content {
        border-radius: 15px;
        border: none;
        background-color: #f1f1f1;
      }
      .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #333;
      }
      .form-control,
      .form-select {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 10px;
      }

      .variant-box {
        background: transparent;
        border: none !important;
        padding: 0 !important;
        margin-bottom: 2rem;
      }
      .add-variant-btn {
        background-color: #000;
        color: #fff;
        border-radius: 5px;
        font-size: 0.8rem;
        padding: 5px 15px;
        float: right;
      }

      .preview-main {
        width: 100%;
        max-width: 250px;
        height: 250px;
        background: #e9e9e9;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 20px auto;
        border-radius: 10px;
        overflow: hidden;
      }
      .preview-thumbnails {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 15px;
      }
      .thumb-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 5px;
        overflow: hidden;
      }
      .thumb-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .thumb-wrapper .remove-img {
        position: absolute;
        top: 2px;
        right: 2px;
        background: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 12px;
        cursor: pointer;
        z-index: 10;
      }

      .btn-save {
        background-color: #007bff;
        color: white;
        border-radius: 5px;
        padding: 8px 40px;
        border: none;
      }
      .btn-cancel {
        background-color: #bbb;
        color: white;
        border-radius: 5px;
        padding: 8px 40px;
        border: none;
      }

      .section-title {
        font-weight: bold;
        font-size: 1.2rem;
        margin-top: 20px;
        margin-bottom: 20px;
        color: #555;
      }

      .cropper-container-wrapper {
        max-height: 400px;
        width: 100%;
        overflow: hidden;
        background-color: #222;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      #cropperImageTarget {
        max-width: 100%;
        max-height: 400px;
        display: block;
      }
    </style>
  </head>

  <body>
    <%- include("../partials/sidebar") %>
    <div class="col-10 px-5 mt-5">
      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Product Management</h3>
        <div class="d-flex gap-2">
          <button
            class="btn btn-dark"
            data-bs-toggle="modal"
            data-bs-target="#addModal"
          >
            + Add Product
          </button>
        </div>
      </div>
      <div class="input-group pb-4">
        <input
          type="text"
          id="searchInput"
          class="form-control"
          placeholder="Search name or brand..."
          onkeypress="if (event.key === 'Enter') performSearch();"
        />
        <button
          class="btn btn-primary"
          style="
            margin-left: 10px;
            border-top-left-radius: inherit;
            border-bottom-left-radius: inherit;
          "
          onclick="performSearch()"
        >
          Search
        </button>
        <button
          class="btn btn-outline-secondary"
          style="margin-left: 10px; border-radius: 0"
          onclick="clearSearch()"
        >
          Clear
        </button>
      </div>
      <div class="card shadow-sm">
        <div class="card-body">
          <table class="table table-hover text-center align-middle">
            <thead class="table-dark">
              <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Brand</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="productTable"></tbody>
          </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <div id="paginationInfo" class="text-muted"></div>
          <nav>
            <ul class="pagination mb-0" id="paginationControls"></ul>
          </nav>
        </div>
      </div>
    </div>

    <div class="modal fade" id="addModal" data-bs-backdrop="static">
      <div class="modal-dialog modal-lg">
        <div class="modal-content p-4">
          <div id="alertBox"></div>
          <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input
              id="name"
              class="form-control"
              placeholder="Enter product name"
            />
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <select id="category" class="form-select"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Brand</label>
              <select id="brand" class="form-select"></select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea id="description" class="form-control" rows="4"></textarea>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="section-title">Variants</span>
            <button class="add-variant-btn" onclick="addVariant()">
              Add Variant
            </button>
          </div>

          <div id="variantContainer"></div>

          <div class="d-flex justify-content-center gap-3 mt-4">
            <button class="btn-save" onclick="submitProduct()">Save</button>
            <button class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="editModal" data-bs-backdrop="static">
      <div class="modal-dialog modal-lg">
        <div class="modal-content p-4">
          <input type="hidden" id="editId" />
          <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input id="editName" class="form-control" />
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <select id="editCategory" class="form-select"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Brand</label>
              <select id="editBrand" class="form-select"></select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea
              id="editDescription"
              class="form-control"
              rows="4"
            ></textarea>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="section-title">Variants</span>
            <button class="add-variant-btn" onclick="addEditVariant()">
              Add Variant
            </button>
          </div>

          <div id="editVariantContainer"></div>

          <div class="d-flex justify-content-center gap-3 mt-4">
            <button
              class="btn-save"
              style="background-color: #0d6efd"
              onclick="updateProduct()"
            >
              Update
            </button>
            <button class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="cropperModal"
      tabindex="-1"
      data-bs-backdrop="static"
      style="z-index: 1060"
    >
      <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">
              Crop Image (<span id="cropProgressText">1/1</span>)
            </h5>
          </div>
          <div class="modal-body p-0">
            <div class="cropper-container-wrapper">
              <img id="cropperImageTarget" src="" alt="Crop Source Layer" />
            </div>
          </div>
          <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-secondary" id="btnSkipCrop">
              Skip
            </button>
            <button type="button" class="btn btn-primary" id="btnConfirmCrop">
              Crop & Next
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- VIEW IMAGES MODAL -->
    <div class="modal fade" id="viewModal">
      <div class="modal-dialog modal-lg">
        <div class="modal-content p-3">
          <h5>Images</h5>
          <div id="imageContainer" class="d-flex flex-wrap gap-2"></div>
        </div>
      </div>
    </div>

    <!-- SUCCESS MODAL -->
    <div class="modal fade" id="successModal">
      <div class="modal-dialog">
        <div class="modal-content text-center p-4">
          <h5 class="mb-3 text-success">Success</h5>
          <p id="successMessage"></p>
          <button class="btn btn-primary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>

    <script>
      const API = "/api/product";
      const CATEGORY_API = "/admin/category";
      const BRAND_API = "/admin/brand";

      let addedFilesMemory = [];
      let currentCropQueue = [];
      let currentQueueIndex = 0;
      let activeCropperInstance = null;
      let activeTargetContainer = null;
      let activeFileInputElement = null;

      function showAlert(message, type = "success") {
        const alertBox = document.getElementById("alertBox");
        alertBox.innerHTML = `
          <div class="alert alert-${type} alert-dismissible fade show">
            ${message}
            <button type="button" class="btn-close" data-bs-alertBox="alert"></button>
          </div>
        `;
      }

      function performSearch() {
        const input = document.getElementById("searchInput");
        const query = input.value.trim();
        if (query === "") {
          loadProducts();
        } else {
          loadProducts(query);
        }
      }

      function clearSearch() {
        document.getElementById("searchInput").value = "";
        loadProducts();
      }

      let currentPage = 1;
      const limit = 15;

      async function loadProducts(searchQuery = "", page = 1) {
        currentPage = page;
        const productTable = document.getElementById("productTable");
        const paginationControls =
          document.getElementById("paginationControls");
        const paginationInfo = document.getElementById("paginationInfo");

        let url = `${API}?page=${page}&limit=${limit}`;
        if (searchQuery) {
          url += `&search=${encodeURIComponent(searchQuery)}`;
        }

        try {
          const res = await fetch(url);
          const data = await res.json();

          productTable.innerHTML = "";
          if (!data.products || data.products.length === 0) {
            productTable.innerHTML = `<tr><td colspan="7" class="text-center text-muted">No products found</td></tr>`;
            paginationControls.innerHTML = "";
            paginationInfo.innerText = "";
            return;
          }

          data.products.forEach((p) => {
            const minPrice = p.variants?.length
              ? Math.min(...p.variants.map((v) => v.price || 0))
              : 0;
            productTable.innerHTML += `
              <tr>
                <td>
                  <img src="${p.variants[0]?.images[0] || "https://via.placeholder.com/60?text=No+Image"}" width="60" height="60" style="object-fit:cover; border-radius:6px;">
                </td>
                <td>${p.name}</td>
                <td>${p.category?.name || "-"}</td>
                <td>${p.brand?.name || "-"}</td>
                <td>₹${minPrice}</td>
                <td><span class="badge ${p.isListed ? "bg-success" : "bg-secondary"}">${p.isListed ? "Listed" : "Unlisted"}</span></td>
                <td>
                  <button class="btn btn-info btn-sm text-white" onclick="viewImages('${p._id}')">View</button>
                  <button class="btn btn-warning btn-sm text-white" onclick="openEdit('${p._id}')">Edit</button>
                  <button class="btn btn-sm ${p.isListed ? "btn-danger" : "btn-success"}" onclick="toggleProduct('${p._id}')">
                    ${p.isListed ? "Unlist" : "List"}
                  </button>
                </td>
              </tr>`;
          });

          renderPagination(data.totalPages, data.currentPage, searchQuery);
        } catch (err) {
          console.error("Error loading products:", err);
        }
      }

      function renderPagination(totalPages, activePage, query) {
        const container = document.getElementById("paginationControls");
        container.innerHTML = "";

        container.innerHTML += `
          <li class="page-item ${activePage === 1 ? "disabled" : ""}">
            <a class="page-link" href="#" onclick="loadProducts('${query}', ${activePage - 1})">&laquo;</a>
          </li>`;

        for (let i = 1; i <= totalPages; i++) {
          container.innerHTML += `
            <li class="page-item ${i === activePage ? "active" : ""}">
              <a class="page-link" href="#" onclick="loadProducts('${query}', ${i})">${i}</a>
            </li>`;
        }

        container.innerHTML += `
          <li class="page-item ${activePage === totalPages ? "disabled" : ""}">
            <a class="page-link" href="#" onclick="loadProducts('${query}', ${activePage + 1})">&raquo;</a>
          </li>`;
      }

      function getVariantHTML(v = null, isEdit = false) {
        const uniqueId = "var_" + Math.random().toString(36).substring(2, 9);
        return `
          <div class="variant-box border-bottom pb-4 mb-4" id="${uniqueId}">
            <div class="row mb-3">
              <div class="col-md-4">
                <label class="form-label">Size</label>
                <select class="form-select size">
                    <option value="S" ${v?.size === "S" ? "selected" : ""}>S</option>
                    <option value="M" ${v?.size === "M" ? "selected" : ""}>M</option>
                    <option value="L" ${v?.size === "L" ? "selected" : ""}>L</option>
                    <option value="XL" ${v?.size === "XL" ? "selected" : ""}>XL</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label d-block">Color</label>
                <input type="color" class="form-control form-control-color w-100 color" value="${v?.color || "#000000"}">
              </div>
              <div class="col-md-4">
                <label class="form-label">Stock Quantity</label>
                <input class="form-control stock" type="number" placeholder="0" value="${v?.stock || ""}">
              </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input class="form-control price" type="number" placeholder="₹" value="${v?.price || ""}">
            </div>
            <div class="mb-3">
              <label class="form-label">Upload Images</label>
              <input type="file" class="form-control images" accept="image/*" multiple>
            </div>
            <div class="preview-main">
               <img src="https://via.placeholder.com/150?text=No+Image" class="main-preview-img" style="max-width:100%">
            </div>
            <div class="preview-thumbnails">
               ${
                 isEdit && v?.images
                   ? v.images
                       .map(
                         (img) => `
                 <div class="thumb-wrapper">
                     <img src="${img}">
                     <button class="remove-img" type="button" onclick="removeExistingImage(this, '${img}')">×</button>
                     <input type="hidden" class="oldImage" value="${img}">
                 </div>`,
                       )
                       .join("")
                   : ""
               }
            </div>
            <button class="btn btn-link text-danger btn-sm p-0 mt-2" type="button" onclick="removeVariantBox('${uniqueId}')">Remove Variant</button>
          </div>`;
      }

      function addVariant() {
        const variantContainer = document.getElementById("variantContainer");
        variantContainer.insertAdjacentHTML("beforeend", getVariantHTML());
      }

      function addEditVariant() {
        const editVariantContainer = document.getElementById(
          "editVariantContainer",
        );
        editVariantContainer.insertAdjacentHTML(
          "beforeend",
          getVariantHTML(null, true),
        );
      }

      function removeVariantBox(id) {
        const target = document.getElementById(id);
        if (target) {
          addedFilesMemory = addedFilesMemory.filter(
            (item) => item.variantBoxElement !== target,
          );
          target.remove();
        }
      }

      function removeExistingImage(btn, imgUrl) {
        btn.parentElement.remove();
      }
      document.addEventListener("change", (e) => {
        if (e.target.classList.contains("images")) {
          const files = Array.from(e.target.files);
          if (!files.length) return;

          activeFileInputElement = e.target;
          activeTargetContainer = e.target.closest(".variant-box");

          let variantMemory = addedFilesMemory.find(
            (item) => item.variantBoxElement === activeTargetContainer,
          );
          if (!variantMemory) {
            variantMemory = {
              variantBoxElement: activeTargetContainer,
              files: [],
            };
            addedFilesMemory.push(variantMemory);
          }

          currentCropQueue = files;
          currentQueueIndex = 0;

          launchCropperInterface();
        }
      });

      function launchCropperInterface() {
        if (currentQueueIndex >= currentCropQueue.length) {
          activeFileInputElement.value = "";
          return;
        }

        const currentFile = currentCropQueue[currentQueueIndex];
        const reader = new FileReader();

        reader.onload = function (event) {
          const cropperImageTarget =
            document.getElementById("cropperImageTarget");
          cropperImageTarget.src = event.target.result;

          document.getElementById("cropProgressText").innerText =
            `${currentQueueIndex + 1}/${currentCropQueue.length}`;

          const cropperModalEl = document.getElementById("cropperModal");
          const cropperModalInstance =
            bootstrap.Modal.getOrCreateInstance(cropperModalEl);
          cropperModalInstance.show();
          if (activeCropperInstance) {
            activeCropperInstance.destroy();
          }

          activeCropperInstance = new Cropper(cropperImageTarget, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
          });
        };

        reader.readAsDataURL(currentFile);
      }

      document
        .getElementById("btnConfirmCrop")
        .addEventListener("click", () => {
          if (!activeCropperInstance) return;

          activeCropperInstance.getClippedCanvas
            ? processCanvasOutput(activeCropperInstance.getClippedCanvas())
            : processCanvasOutput(
                activeCropperInstance.getCoveredCanvas
                  ? activeCropperInstance.getSelectionCanvas()
                  : activeCropperInstance.getCroppedCanvas(),
              );
        });

      function processCanvasOutput(canvas) {
        if (!canvas) {
          bypassImageCropping();
          return;
        }

        canvas.toBlob(
          (blob) => {
            const originalName = currentCropQueue[currentQueueIndex].name;
            const transformedFile = new File([blob], originalName, {
              type: "image/jpeg",
            });
            let variantMemory = addedFilesMemory.find(
              (item) => item.variantBoxElement === activeTargetContainer,
            );
            variantMemory.files.push(transformedFile);

            renderVariantThumbnails(activeTargetContainer, transformedFile);

            closeAndAdvanceQueue();
          },
          "image/jpeg",
          0.9,
        );
      }

      document
        .getElementById("btnSkipCrop")
        .addEventListener("click", bypassImageCropping);

      function bypassImageCropping() {
        const rawFile = currentCropQueue[currentQueueIndex];
        let variantMemory = addedFilesMemory.find(
          (item) => item.variantBoxElement === activeTargetContainer,
        );
        variantMemory.files.push(rawFile);

        renderVariantThumbnails(activeTargetContainer, rawFile);
        closeAndAdvanceQueue();
      }

      function closeAndAdvanceQueue() {
        currentQueueIndex++;
        if (currentQueueIndex < currentCropQueue.length) {
          launchCropperInterface();
        } else {
          const cropperModalEl = document.getElementById("cropperModal");
          bootstrap.Modal.getInstance(cropperModalEl).hide();
          if (activeCropperInstance) {
            activeCropperInstance.destroy();
            activeCropperInstance = null;
          }
        }
      }

      function renderVariantThumbnails(container, file) {
        const thumbContainer = container.querySelector(".preview-thumbnails");
        const mainPreview = container.querySelector(".main-preview-img");

        const reader = new FileReader();
        reader.onload = (event) => {
          if (
            thumbContainer.children.length === 0 ||
            mainPreview.src.includes("placeholder.com")
          ) {
            mainPreview.src = event.target.result;
          }

          const idMark = "img_" + Math.random().toString(36).substring(2, 9);
          const wrapper = document.createElement("div");
          wrapper.className = "thumb-wrapper";
          wrapper.id = idMark;
          wrapper.innerHTML = `
            <img src="${event.target.result}">
            <button class="remove-img" type="button" onclick="removeBlobMemoryImage(this, '${container.id}', '${file.name}')">×</button>
          `;
          thumbContainer.appendChild(wrapper);
        };
        reader.readAsDataURL(file);
      }

      function removeBlobMemoryImage(btn, containerId, filename) {
        const box = document.getElementById(containerId);
        let variantMemory = addedFilesMemory.find(
          (item) => item.variantBoxElement === box,
        );
        if (variantMemory) {
          const idx = variantMemory.files.findIndex((f) => f.name === filename);
          if (idx !== -1) variantMemory.files.splice(idx, 1);
        }

        const wrapper = btn.parentElement;
        const parentContainer = wrapper.parentElement;
        wrapper.remove();
        const remainingImg = parentContainer.querySelector("img");
        const mainPreview = box.querySelector(".main-preview-img");
        if (remainingImg) {
          mainPreview.src = remainingImg.src;
        } else {
          mainPreview.src = "https://via.placeholder.com/150?text=No+Image";
        }
      }

      async function submitProduct() {
        try {
          const name = document.getElementById("name").value.trim();
          const desc = document.getElementById("description").value.trim();
          const catVal = document.getElementById("category").value;
          const brandVal = document.getElementById("brand").value;

          if (!name) return showAlert("Product name is required", "danger");
          if (!catVal) return showAlert("Please select a category", "danger");
          if (!brandVal) return showAlert("Please select a brand", "danger");
          if (!desc) return showAlert("Description is required", "danger");

          const variantBoxes = document.querySelectorAll(
            "#variantContainer .variant-box",
          );
          if (variantBoxes.length === 0)
            return showAlert("Add at least one variant", "danger");

          const formData = new FormData();
          formData.append("name", name);
          formData.append("description", desc);
          formData.append("category", catVal);
          formData.append("brand", brandVal);

          let variants = [];

          for (const box of variantBoxes) {
            const size = box.querySelector(".size").value;
            const color = box.querySelector(".color").value;
            const price = box.querySelector(".price").value.trim();
            const stock = box.querySelector(".stock").value.trim();

            if (!price || price <= 0)
              return showAlert("Enter valid variant price", "danger");
            if (!stock || stock < 0)
              return showAlert("Enter valid stock quantity", "danger");

            let memoryRecord = addedFilesMemory.find(
              (item) => item.variantBoxElement === box,
            );
            const variantFiles = memoryRecord ? memoryRecord.files : [];

            if (variantFiles.length === 0) {
              return showAlert("Please upload variant images", "danger");
            }

            let images = [];
            for (let i = 0; i < variantFiles.length; i++) {
              formData.append("variantImages", variantFiles[i]);
              images.push("temp");
            }

            variants.push({size, color, price, stock, images});
          }

          formData.append("variants", JSON.stringify(variants));

          const res = await fetch(`${API}/add`, {
            method: "POST",
            body: formData,
          });

          const data = await res.json();
          if (!res.ok)
            return showAlert(data.message || "Failed to add product", "danger");

          showAlert(data.message || "Product added successfully", "success");
          bootstrap.Modal.getInstance(
            document.getElementById("addModal"),
          ).hide();

          addedFilesMemory = [];
          document.getElementById("variantContainer").innerHTML = "";
          document.getElementById("name").value = "";
          document.getElementById("description").value = "";

          loadProducts();
        } catch (error) {
          console.error(error);
          showAlert("Something went wrong", "danger");
        }
      }

      async function openEdit(id) {
        const res = await fetch(`${API}/edit/${id}`);
        const p = await res.json();

        document.getElementById("editId").value = p._id;
        document.getElementById("editName").value = p.name;
        document.getElementById("editDescription").value = p.description;

        await loadEditCategories(p.category?._id);
        await loadEditBrands(p.brand?._id);

        const editVariantContainer = document.getElementById(
          "editVariantContainer",
        );
        editVariantContainer.innerHTML = "";

        p.variants.forEach((v) => {
          editVariantContainer.insertAdjacentHTML(
            "beforeend",
            getVariantHTML(v, true),
          );
        });

        new bootstrap.Modal(document.getElementById("editModal")).show();
      }

      async function updateProduct() {
        const formData = new FormData();
        formData.append("name", document.getElementById("editName").value);
        formData.append(
          "description",
          document.getElementById("editDescription").value,
        );
        formData.append(
          "category",
          document.getElementById("editCategory").value,
        );
        formData.append("brand", document.getElementById("editBrand").value);

        let variants = [];
        const boxes = document.querySelectorAll(
          "#editVariantContainer .variant-box",
        );

        for (const box of boxes) {
          let oldImages = [];
          box
            .querySelectorAll(".oldImage")
            .forEach((img) => oldImages.push(img.value));

          let memoryRecord = addedFilesMemory.find(
            (item) => item.variantBoxElement === box,
          );
          const variantFiles = memoryRecord ? memoryRecord.files : [];

          let images = [...oldImages];
          for (let i = 0; i < variantFiles.length; i++) {
            formData.append("variantImages", variantFiles[i]);
            images.push("temp");
          }

          variants.push({
            size: box.querySelector(".size").value,
            color: box.querySelector(".color").value,
            price: box.querySelector(".price").value,
            stock: box.querySelector(".stock").value,
            images,
          });
        }

        formData.append("variants", JSON.stringify(variants));

        await fetch(`${API}/edit/${document.getElementById("editId").value}`, {
          method: "PUT",
          body: formData,
        });

        location.reload();
      }

      async function viewImages(id) {
        const res = await fetch(`${API}/edit/${id}`);
        const p = await res.json();
        const container = document.getElementById("imageContainer");
        container.innerHTML = p.variants
          .flatMap((v) => v.images)
          .map(
            (img) => `<img src="${img}" width="100" class="rounded shadow-sm">`,
          )
          .join("");
        new bootstrap.Modal(document.getElementById("viewModal")).show();
      }

      async function toggleProduct(id) {
        await fetch(`${API}/toggle/${id}`, {method: "PATCH"});
        const currentQuery = document.getElementById("searchInput").value;
        loadProducts(currentQuery, currentPage);
      }

      async function loadCategories() {
        const res = await fetch(CATEGORY_API);
        const data = await res.json();
        const categorySelect = document.getElementById("category");
        categorySelect.innerHTML = data.categories
          .map((c) => `<option value="${c._id}">${c.name}</option>`)
          .join("");
      }

      async function loadBrands() {
        const res = await fetch(BRAND_API);
        const data = await res.json();
        const brandSelect = document.getElementById("brand");
        brandSelect.innerHTML = data
          .map((b) => `<option value="${b._id}">${b.name}</option>`)
          .join("");
      }

      async function loadEditCategories(selected) {
        const res = await fetch(CATEGORY_API);
        const data = await res.json();
        const editCategorySelect = document.getElementById("editCategory");
        editCategorySelect.innerHTML = data.categories
          .map(
            (c) =>
              `<option value="${c._id}" ${c._id === selected ? "selected" : ""}>${c.name}</option>`,
          )
          .join("");
      }

      async function loadEditBrands(selected) {
        const res = await fetch(BRAND_API);
        const data = await res.json();
        const editBrandSelect = document.getElementById("editBrand");
        editBrandSelect.innerHTML = data
          .map(
            (b) =>
              `<option value="${b._id}" ${b._id === selected ? "selected" : ""}>${b.name}</option>`,
          )
          .join("");
      }

      loadProducts();
      loadCategories();
      loadBrands();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
  </body>
</html>
